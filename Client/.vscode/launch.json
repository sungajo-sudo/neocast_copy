{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PenStreamClient Web: Dev Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/PenStreamClient/Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "PenStreamClient Web: Debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/PenStreamClient/Web/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    },
    {
      "name": "PenStreamClient Web: Build",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/PenStreamClient/Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build"],
      "console": "integratedTerminal"
    },
    {
      "name": "PenStreamClient Web: Preview",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/PenStreamClient/Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "PenStreamClient Web: Dev + Debug",
      "configurations": ["PenStreamClient Web: Dev Server", "PenStreamClient Web: Debug in Chrome"],
      "stopAll": true
    }
  ]
}
