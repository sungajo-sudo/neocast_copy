# Server
PORT=8190
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/penstreamdb?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Session
SESSION_CODE_LENGTH=6
MAX_GUESTS_PER_SESSION=100

# Logging
LOG_LEVEL=info

# CORS (production uses this, development ignores)
# Comma-separated origins, e.g. "https://app.example.com,https://admin.example.com"
CORS_ORIGINS=""

# Storage (local or gcs)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# GCS 에뮬레이터 사용 시 (penstream-gcs 컨테이너, port 4443)
# STORAGE_TYPE=gcs
# GCS_PROJECT_ID=neocast-local
# GCS_BUCKET_PREFIX=neocast-dev
# GCS_EMULATOR_HOST=http://localhost:4443

# GCS Production 설정 (Cloud Run 배포 시)
# STORAGE_TYPE=gcs
# GCS_PROJECT_ID=livecast-484008
# GCS_BUCKET_PREFIX=neocast-prod
# 버킷: neocast-prod-files, neocast-prod-papers

# OCI Object Storage 설정 (OCI 배포 시)
# STORAGE_TYPE=oci
# OCI_BUCKET_PREFIX=neocast
# OCI_COMPARTMENT_ID=ocid1.compartment...
# OCI_REGION=ap-seoul-1
# OCI_NAMESPACE=              # 비워두면 자동 조회
# OCI_TENANCY_ID=ocid1.tenancy...
# OCI_USER_ID=ocid1.user...
# OCI_FINGERPRINT=xx:xx:xx:...
# OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OCI_PASSPHRASE=
# 버킷: neocast-files, neocast-papers
