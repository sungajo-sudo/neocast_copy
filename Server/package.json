    "@fastify/multipart": "^8.3.0",
    "@google-cloud/storage": "^7.18.0",
    "@prisma/client": "^5.17.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "oci-common": "^2.125.0",
    "oci-objectstorage": "^2.125.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
